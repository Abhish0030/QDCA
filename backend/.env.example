NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://username:password@localhost:5432/qdca
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Optional: social sign-in providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_DEBUG_LOGS=false

EMAIL_FROM=QDCA <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_EMAILS=

# Amazon Bedrock / Nova Pro env vars were removed and are no longer used.
# Keep any legacy AWS Bedrock secrets out of new deployments unless another service still needs them.

# Optional: Groq hosted model
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: OpenRouter / hosted fallback model
	OPENROUTER_API_KEY=
	# Separate OpenRouter API key used only for the Gemma fallback slot.
	OPENROUTER_GEMMA_API_KEY=
	OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
	OPENROUTER_NEMOTRON_MODEL=tencent/hy3:free
	
	# Optional: API key sent as X-API-Key to the Ollama reverse proxy
	OLLAMA_API_KEY=
	# Point this at the host where Ollama is running; use localhost only for local dev.
	OLLAMA_BASE_URL=http://your-ollama-host:11434
	OLLAMA_LLAMA_MODEL=llama3.2
	OLLAMA_GEMMA_MODEL=gemma3:1b

OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_FAST_MODEL=gemma3:1b
OLLAMA_FALLBACK_MODEL=llama3.2
RAG_MATCH_THRESHOLD=0.55
OLLAMA_NUM_CTX=2048
OLLAMA_REQUEST_TIMEOUT_MS=30000
OLLAMA_KEEP_ALIVE=15m
OLLAMA_CHAT_TIMEOUT_MS=22000
OLLAMA_CHAT_NUM_PREDICT=180
OLLAMA_CHAT_MESSAGE_LIMIT=6
OLLAMA_CHAT_CONTEXT_CACHE_TTL_MS=15000
OLLAMA_CHAT_TEMPERATURE_X100=20
PDF_DEBUG=false
